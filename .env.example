# Supabase values used by server-side code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# SERVER ONLY: never expose this value through a VITE_ variable or client code.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Browser-safe Supabase values embedded by Vite in the client bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
