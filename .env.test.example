# Dedicated Supabase project used only for Didaktiva integration tests.
# Copy to .env.test.local. Never point these values at production.
TEST_ENV=true
TEST_ALLOW_DESTRUCTIVE_FIXTURES=yes-dedicated-test-project

TEST_SUPABASE_URL=https://your-isolated-test-project-ref.supabase.co
TEST_SUPABASE_PROJECT_REF=your-isolated-test-project-ref
TEST_SUPABASE_ANON_KEY=your-test-anon-or-publishable-key

# SERVER/TEST-RUNNER ONLY. Never add VITE_ to this variable.
TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key

# Public project reference only; used by the guard to reject production.
PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref

# Use non-personal credentials created only in the isolated test project.
TEST_TEACHER_A_EMAIL=didaktiva.test.teacher.a@example.invalid
TEST_TEACHER_A_PASSWORD=replace-with-a-strong-test-only-password
TEST_TEACHER_B_EMAIL=didaktiva.test.teacher.b@example.invalid
TEST_TEACHER_B_PASSWORD=replace-with-a-different-strong-test-only-password

# Optional: retain fixture rows after a run for manual browser smoke tests.
# The default is false, which cleans rows automatically but retains auth users.
TEST_KEEP_FIXTURES=false
